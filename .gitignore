# Generated media, transcripts and the gallery manifest.
# The folders themselves are kept (with .gitkeep) so a fresh clone has them.
static/clips/*
static/downloads/*
static/transcripts/*
static/tmp/*
!static/clips/.gitkeep
!static/downloads/.gitkeep
!static/transcripts/.gitkeep
!static/tmp/.gitkeep

