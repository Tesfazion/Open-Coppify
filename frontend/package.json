{
  "name": "coppify-frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "React + TypeScript + Tailwind front end for the Coppify video-to-shorts backend",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4041",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.7.2",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=20.19"
  }
}
